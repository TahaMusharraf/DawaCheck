// DawaCheck — off-chain data model.
// Anything trust-critical lives on-chain in MedicineRegistry; this database holds
// everything else: profiles, Merkle proofs, scans and risk scoring.
// Rows that mirror chain state carry the txHash that produced them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrgType {
  REGULATOR
  MANUFACTURER
  DISTRIBUTOR
  PHARMACY
}

enum OrgStatus {
  PENDING
  LICENSED
  REVOKED
}

enum UserRole {
  ADMIN
  STAFF
}

enum UnitStatus {
  ISSUED
  SOLD
}

enum ScanResult {
  AUTHENTIC
  NOT_REGISTERED
  EXPIRED
  RECALLED
  CLONE_SUSPECTED
}

enum AlertStatus {
  OPEN
  INVESTIGATING
  CONFIRMED
  DISMISSED
}

model Organization {
  id             String    @id @default(cuid())
  name           String
  type           OrgType
  status         OrgStatus @default(PENDING)
  licenseNo      String    @unique
  city           String
  /// Custodial wallet, created by the backend when the regulator approves.
  walletAddress  String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users          User[]
  batches        Batch[]
  custodySent    CustodyEvent[] @relation("CustodyFrom")
  custodyReceived CustodyEvent[] @relation("CustodyTo")
  recallsIssued  Recall[]
  unitsHeld      Unit[]

  @@index([type, status])
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Batch {
  /// keccak256 of batchNumber — the same id the contract stores.
  batchId        String   @id
  batchNumber    String   @unique
  drugName       String
  dosage         String
  manufacturerId String
  merkleRoot     String
  quantity       Int
  mfgDate        DateTime
  expiryDate     DateTime
  recalled       Boolean  @default(false)
  ipfsCid        String?
  txHash         String?
  createdAt      DateTime @default(now())

  manufacturer   Organization   @relation(fields: [manufacturerId], references: [id])
  units          Unit[]
  custodyEvents  CustodyEvent[]
  recall         Recall?
  alerts         CounterfeitAlert[]

  @@index([manufacturerId])
  @@index([expiryDate])
}

model Unit {
  /// keccak256(abi.encode(batchId, code)). The raw code exists only on the pack.
  unitHash        String     @id
  batchId         String
  /// Sibling hashes that prove this unit belongs to the batch root.
  merkleProof     Json
  status          UnitStatus @default(ISSUED)
  /// Best-effort per-unit location, derived from dispatch/receive scans.
  currentHolderId String?
  soldAt          DateTime?
  createdAt       DateTime   @default(now())

  batch           Batch         @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  currentHolder   Organization? @relation(fields: [currentHolderId], references: [id])
  scans           ScanEvent[]
  alerts          CounterfeitAlert[]

  @@index([batchId])
  @@index([currentHolderId])
}

/// One on-chain transferCustody call: a quantity of a batch moving between parties.
model CustodyEvent {
  id          String   @id @default(cuid())
  batchId     String
  fromOrgId   String
  toOrgId     String
  quantity    Int
  txHash      String
  blockNumber BigInt
  occurredAt  DateTime

  batch       Batch        @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  fromOrg     Organization @relation("CustodyFrom", fields: [fromOrgId], references: [id])
  toOrg       Organization @relation("CustodyTo", fields: [toOrgId], references: [id])

  @@unique([txHash, batchId])
  @@index([batchId])
  @@index([toOrgId])
}

model Recall {
  id            String   @id @default(cuid())
  batchId       String   @unique
  reason        String
  issuedByOrgId String
  txHash        String
  issuedAt      DateTime

  batch         Batch        @relation(fields: [batchId], references: [batchId], onDelete: Cascade)
  issuedBy      Organization @relation(fields: [issuedByOrgId], references: [id])
}

/// Privacy: hashed IP and device, city-level coordinates only. Never who scanned.
model ScanEvent {
  id         String     @id @default(cuid())
  unitHash   String
  result     ScanResult
  ipHash     String
  deviceHash String
  city       String?
  lat        Float?
  lng        Float?
  riskScore  Int        @default(0)
  riskFlags  String[]
  scannedAt  DateTime   @default(now())

  unit       Unit       @relation(fields: [unitHash], references: [unitHash], onDelete: Cascade)

  @@index([unitHash, scannedAt])
  @@index([scannedAt])
}

model CounterfeitAlert {
  id            String      @id @default(cuid())
  unitHash      String
  batchId       String
  ruleTriggered String
  severity      Int
  status        AlertStatus @default(OPEN)
  city          String?
  createdAt     DateTime    @default(now())
  resolvedAt    DateTime?

  unit          Unit        @relation(fields: [unitHash], references: [unitHash], onDelete: Cascade)
  batch         Batch       @relation(fields: [batchId], references: [batchId], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([batchId])
}

/// Lets the indexer resume from where it stopped after a free-tier cold start.
model IndexerCheckpoint {
  id                 String   @id @default(cuid())
  contractAddress    String
  chainId            Int
  lastBlockProcessed BigInt
  updatedAt          DateTime @updatedAt

  @@unique([contractAddress, chainId])
}
